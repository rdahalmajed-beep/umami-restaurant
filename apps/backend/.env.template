# Neon (recommended) or any PostgreSQL 15+
DATABASE_URL=postgresql://USER:PASSWORD@HOST/restaurant?sslmode=require

STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:7001,http://localhost:5173
AUTH_CORS=http://localhost:8000,http://localhost:3000,http://localhost:9000,http://localhost:5173

JWT_SECRET=replace-with-a-long-random-development-secret
COOKIE_SECRET=replace-with-another-long-random-development-secret
AUTH_MFA_ENCRYPTION_KEY=replace-with-64-char-hex-or-long-random-secret

MEDUSA_ADMIN_ONBOARDING_TYPE=nextjs
MEDUSA_ADMIN_ONBOARDING_NEXTJS_DIRECTORY=restaurant-platform/apps/storefront

# Catalog translations + store locales (also enabled via featureFlags.translation in medusa-config.ts)
MEDUSA_FF_TRANSLATION=true

# Add only when Redis is actually required by Medusa features you enable:
# REDIS_URL=redis://localhost:6379

# --- Render production (see docs/RENDER_MEDUSA.md) ---
# NODE_ENV=production
# MEDUSA_WORKER_MODE=shared
# MEDUSA_BACKEND_URL=https://umami-medusa.onrender.com
# DISABLE_MEDUSA_ADMIN=false
# DATABASE_URL=... (from Render Postgres)
# REDIS_URL=... (from Render Key Value)
# STORE_CORS=https://YOUR_STORE.vercel.app
# ADMIN_CORS=https://umami-medusa.onrender.com
# AUTH_CORS=https://umami-medusa.onrender.com,https://YOUR_STORE.vercel.app

# Guest order status HMAC (ORD-004). Required in production.
# RESTAURANT_GUEST_STATUS_SECRET=replace-with-long-random-secret

# Storefront cache revalidation (CACHE-001). Same secret on storefront.
# STOREFRONT_REVALIDATE_URL=http://localhost:8000/api/revalidate
# REVALIDATE_SECRET=replace-with-shared-revalidate-secret

# Optional: POST outbox payloads here (email/SMS/Make.com). Without it, job stubs "sent".
# NOTIFICATION_WEBHOOK_URL=https://your-notifier.example/hooks/restaurant

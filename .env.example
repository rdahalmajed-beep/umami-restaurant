# Copy values into apps/backend/.env and apps/storefront/.env.local
# Do not commit real secrets.

# --- Backend (apps/backend/.env) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/restaurant?sslmode=require
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:7001,http://localhost:5173
AUTH_CORS=http://localhost:8000,http://localhost:3000,http://localhost:9000,http://localhost:5173
JWT_SECRET=replace-with-a-long-random-development-secret
COOKIE_SECRET=replace-with-another-long-random-development-secret

# --- Storefront (apps/storefront/.env.local) ---
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=bh

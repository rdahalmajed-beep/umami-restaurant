# Copy values into apps/backend/.env and apps/storefront/.env.local
# Do not commit real secrets.

# --- Backend (apps/backend/.env) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/restaurant?sslmode=require
STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:7001,http://localhost:5173
AUTH_CORS=http://localhost:8000,http://localhost:3000,http://localhost:9000,http://localhost:5173
JWT_SECRET=replace-with-a-long-random-development-secret
COOKIE_SECRET=replace-with-another-long-random-development-secret
MEDUSA_FF_TRANSLATION=true
# STOREFRONT_REVALIDATE_URL=http://localhost:8000/api/revalidate
# REVALIDATE_SECRET=replace-with-shared-revalidate-secret
# RESTAURANT_GUEST_STATUS_SECRET=replace-with-long-random-secret

# --- Storefront (apps/storefront/.env.local) ---
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=bh
# Shared with backend REVALIDATE_SECRET for menu/content cache busting
REVALIDATE_SECRET=replace-with-shared-revalidate-secret

# --- Vercel (production storefront) ---
# NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.your-domain.com
# NEXT_PUBLIC_BASE_URL=https://YOUR_APP.vercel.app
# Also add YOUR_APP.vercel.app to backend STORE_CORS / AUTH_CORS
# See docs/VERCEL_STOREFRONT.md
